# ==============================================================================
# MedDiet Pro — Reglas de Exclusión de Git (.gitignore)
# ==============================================================================

# Credenciales privadas de hosting (NUNCA se suben a GitHub)
config/db.local.php
config/*.local.php
config/credentials.php
.env
.env.*
!.env.example

# Datos locales de MariaDB / MySQL en Docker (evita fallos de permisos root y binarios)
data/

# Ficheros y notas de la carpeta docs
docs/*
!docs/.gitkeep

# Registros de log y archivos temporales
*.log

# Archivos temporales de sistemas operativos
.DS_Store
Thumbs.db
