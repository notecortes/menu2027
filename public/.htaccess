# ==============================================================================
# MedDiet Pro — Apache Configuración para /public
# ==============================================================================

Options -Indexes
AddDefaultCharset UTF-8
DirectoryIndex index.php index.html

<FilesMatch "(^\.env|^\.git|docker-compose\.ya?ml|Dockerfile.*|.*\.sql|.*\.sh|htaccess\.conf|db\.local\.php|\.md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set X-XSS-Protection "1; mode=block"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Enrutar peticiones a la API del nivel superior si se llaman desde /public/api/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^api/(.*)$ ../api/$1 [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>
